{
  "expo": {
    "name": "Otto",
    "slug": "otto-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "otto",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#1a1a1c",
    "splash": {
      "backgroundColor": "#0d0d0e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.project96.otto",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0e"
      },
      "package": "com.otto.mobile",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Otto uses the camera to scan the pairing QR code shown in Otto on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Otto lets you pick photos to attach to a message for Otto on your computer.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/allow-http"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
